# Ignorar arquivos temporários mesmo com extensões permitidas
*.tmp *.temp *.cache *.log *.bak *.backup *~

# Ignorar arquivos de configuração local

.env .env.local .env.production .env.development config.local.php database.local.php

# Ignorar arquivos de IDE/Editor
.vscode/ .idea/ *.swp *.swo *~

# Ignorar arquivos de sistema
.DS_Store Thumbs.db desktop.ini

# Ignorar arquivos de backup/versão
*.orig *.rej *.old

# Ignorar arquivos de banco de dados
*.sql *.db *.sqlite

# Ignorar arquivos de imagem
*.jpg *.jpeg *.png *.gif *.bmp *.ico *.svg *.webp *.avif

# Ignorar arquivos de documento
*.pdf *.doc *.docx *.xls *.xlsx *.txt *.rtf

# Ignorar arquivos compactados
*.zip *.rar *.tar *.gz *.7z

# Ignorar arquivos de configuração de servidor
.htaccess web.config robots.txt sitemap.xml

# Ignorar arquivos de log específicos
error_log access_log *.log

# Ignorar arquivos de sessão
sess_* *.session

# Ignorar arquivos de cache de navegador
*.cache cache/

# Ignorar arquivos de configuração de ambiente
.env*

!.env.example
ode_modules
